nt/blob/master/vaderSentiment/vader_lexicon.txt","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"dictionary","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"CrGK3vp1bO"}],"urlSource":"https://github.com/cjhutto/vaderSentiment/blob/master/vaderSentiment/vader_lexicon.txt","data":{"kind":"file","org":"cjhutto","repo":"vaderSentiment","reference":"master","file":"vaderSentiment/vader_lexicon.txt","raw":"https://raw.githubusercontent.com/cjhutto/vaderSentiment/master/vaderSentiment/vader_lexicon.txt"},"internal":false,"protocol":"github","key":"qbA3Nd87Vk"},{"type":"text","value":", plus applying a set of rules to deal with negation and other linguistic phenomena that may change the score","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"FJsXKZD98w"}],"key":"uKtpPvzUVV"}],"key":"RZcMJmaoWU"}],"key":"h5aVZQbj24"}],"key":"X5WmR3YEpR"}],"key":"MFoiv7n13c"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"There is an implementation of VADER in NLTK, so we will use that version.","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"edy3evi44j"}],"key":"if7r62X0kE"}],"key":"Fglv1UWTEJ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import statements","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sGprKfzGGt"}],"identifier":"import-statements","label":"Import statements","html_id":"import-statements","implicit":true,"key":"ub9DI0tqdt"}],"key":"G4Qjlr18kH"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import os\nimport pandas\nimport nltk\nfrom nltk.sentiment.vader import SentimentIntensityAnalyzer","key":"izeJKvRQPu"},{"type":"outputs","id":"vNvaHCL1zFWKHFAhvl384","children":[],"key":"b7j4GJH1LM"}],"key":"VvfYus5N1o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# create an instance of the analyzer\nanalyzer = SentimentIntensityAnalyzer()","key":"kf1t2bpG4Y"},{"type":"outputs","id":"wazYcbyMg7BeS69_xGSrt","children":[],"key":"Kt3EnBDuHY"}],"key":"knmvACzDej"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Try with toy sentences","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OjaPIVTmTW"}],"identifier":"try-with-toy-sentences","label":"Try with toy sentences","html_id":"try-with-toy-sentences","implicit":true,"key":"RxjjRCffQE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"A couple of toy sentences and a list of examples from the VADER repository.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"prVQi7qPLc"}],"key":"oaIGdxiBIW"}],"key":"B1kLUL6ksN"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sent1 = \"I really like you.\"\n\nprint(analyzer.polarity_scores(sent1))","key":"iZIYVOPXzc"},{"type":"outputs","id":"qHDdqUS88kSvIpRcga8qB","children":[],"key":"s4PykirW19"}],"key":"NSsXZFIH5Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sent2 = \"I really really really very much like you.\"\n\nprint(analyzer.polarity_scores(sent2))","key":"CATZObw9Ym"},{"type":"outputs","id":"gXFy_u4BZ68w-SaS-0ze4","children":[],"key":"TaQVfkaSiP"}],"key":"d6hfbjHE3L"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sent3 = \"I had a horrible, terrible, no good day\"\n\nprint(analyzer.polarity_scores(sent3))","key":"dMqJi05yVx"},{"type":"outputs","id":"R8Na8Lk5hwPV1JTxjzXwj","children":[],"key":"htmugWNjPk"}],"key":"HptR0kEgcS"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"sent3 = \"I haven't read a better book\"\n\nprint(analyzer.polarity_scores(sent3))","key":"TLB8AK2BZa"},{"type":"outputs","id":"1EeSUBjaigtd4PslF0Ssh","children":[],"key":"vsK4pckiDs"}],"key":"iQWrMT5hcF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"cTu85qTBwM"},{"type":"outputs","id":"NjUovt9GNvR8IQsrj8lRj","children":[],"key":"SAKhorKLmQ"}],"key":"Ra4Ko2pE9B"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# these are sample sentences from VADER\nsentences = [\"VADER is smart, handsome, and funny.\",  # positive sentence example\n             \"VADER is smart, handsome, and funny!\",  # punctuation emphasis handled correctly (sentiment intensity adjusted)\n             \"VADER is very smart, handsome, and funny.\", # booster words handled correctly (sentiment intensity adjusted)\n             \"VADER is VERY SMART, handsome, and FUNNY.\",  # emphasis for ALLCAPS handled\n             \"VADER is VERY SMART, handsome, and FUNNY!!!\", # combination of signals - VADER appropriately adjusts intensity\n             \"VADER is VERY SMART, uber handsome, and FRIGGIN FUNNY!!!\", # booster words & punctuation make this close to ceiling for score\n             \"VADER is not smart, handsome, nor funny.\",  # negation sentence example\n             \"The book was good.\",  # positive sentence\n             \"At least it isn't a horrible book.\",  # negated negative sentence with contraction\n             \"The book was only kind of good.\", # qualified positive sentence is handled correctly (intensity adjusted)\n             \"The plot was good, but the characters are uncompelling and the dialog is not great.\", # mixed negation sentence\n             \"Today SUX!\",  # negative slang with capitalization emphasis\n             \"Today only kinda sux! But I'll get by, lol\", # mixed sentiment example with slang and constrastive conjunction \"but\"\n             \"Make sure you :) or :D today!\",  # emoticons handled\n             \"Catch utf-8 emoji such as such as 💘 and 💋 and 😁\",  # emojis handled\n             \"Not bad at all\"  # Capitalized negation\n             ]","key":"dEUymTN1Ng"},{"type":"outputs","id":"xxdkra3LW7edFHiv-oKWW","children":[],"key":"CDKPGvf0yl"}],"key":"fW9UTfkwmk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"for sentence in sentences:\n    vs = analyzer.polarity_scores(sentence)\n    print(\"{:-<60} {}\".format(sentence, str(vs)))","key":"aJ3G59RBoq"},{"type":"outputs","id":"6RXBJGlwwHGsjqRcP4rfN","children":[],"key":"KAeyBnbMpW"}],"key":"lNhk1lLBDs"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# another way to print\nfor sentence in sentences:\n    scores = analyzer.polarity_scores(sentence)\n    print(sentence)\n    print(\"   \", scores)","key":"B3RzHxNQCb"},{"type":"outputs","id":"tp1DG0P_zs13H0oPx3oSj","children":[],"key":"HQtOIDgLng"}],"key":"unubrlTLCA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Movie reviews","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HzhLQ1f3XF"}],"identifier":"movie-reviews","label":"Movie reviews","html_id":"movie-reviews","implicit":true,"key":"omkNW43Vyx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Next, we will analyze some movie reviews from the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sY3aU98JQH"},{"type":"link","url":"https://www.sfu.ca/~mtaboada/SFU_Review_Corpus.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"SFU Review Corpus","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wgHrhYuUqz"}],"urlSource":"https://www.sfu.ca/~mtaboada/SFU_Review_Corpus.html","key":"H1Xj3R21LM"},{"type":"text","value":". They are in the ‘reviews’ directory.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"viwc1iYduS"}],"key":"mPCDpcR4jx"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"We will just do the usual process of defining a function to calculate the score and another function to process the directory and call the calculating function. Note that I am creating the analyzer here again. This is because you want to be able to run this function by itself, without the statement above.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"yRZJs15Hyv"}],"key":"C9NR2UALM1"}],"key":"dXdbLlscJc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def get_sentiment_scores(text):\n    \"\"\"\n    Uses VADER within NLTK to calculate sentiment\n    \n    Args:\n        text (str): a string containing the file or text\n        \n    Returns: \n        dict: a dictionary that VADER creates\n    \"\"\"\n    analyzer = SentimentIntensityAnalyzer()\n    score = analyzer.polarity_scores(text)\n    return score\n\ndef process_dir(path):\n    \"\"\"\n    Reads all the files in a directory. Processes them using the 'get_sentiment_scores' function\n    \n    Args: \n        path (str): path to the directory where the files are\n        \n    Returns:\n        dict: a dictionary with file names as keys and the tokens, types, lexical diversity, as values\n    \n    \"\"\"\n    scores = {}\n\n    for filename in os.listdir(path):\n        if filename.endswith(\".txt\"):    \n            file_path = os.path.join(path, filename)      \n            with open(file_path, 'r', encoding=\"utf-8\") as f:\n                text = f.read()\n                scores[filename] = get_sentiment_scores(text)\n    return scores","key":"Ng1vn4kTAl"},{"type":"outputs","id":"n79ECOtMidyV1nHDbqgdT","children":[],"key":"QBKG1QbYyN"}],"key":"QbuVpzgQS1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"path = './reviews'\n\nscores_files = process_dir(path)","key":"i53CAa3KWK"},{"type":"outputs","id":"RjY8kAWD7P9yDX-k9Z1ZU","children":[],"key":"RJQQTmipQF"}],"key":"ttwvZck7mM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(scores_files)","key":"FjuieXhdeo"},{"type":"outputs","id":"uZH2TFTXTo9e78wUUfZoZ","children":[],"key":"pP4NWHuMJG"}],"key":"qGwfRScteL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# of course, pandas makes everything look better\ndf = pandas.DataFrame.from_dict(scores_files, orient=\"index\")\ndf","key":"FFLzCxJs5K"},{"type":"outputs","id":"r3I3sJdx2vAWsiapZR6ls","children":[],"key":"STjsSRu404"}],"key":"I6BwIUZJ4Q"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Tx2ifp3ppC"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"j0dAnWOsW0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We have learned about sentiment analysis and how to run a ‘classic’ method for sentiment, VADER.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hCMfBu0qHD"}],"key":"WxXkNKIuZo"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Read the files and compare the scores to the text in the files. Do you agree with what VADER says? Why or why not?","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"o86IKGwX1j"}],"key":"jTzhHSFLYq"}],"key":"fDvFMr5g3M"}],"key":"dFyGYpYMMY"},"references":{"cite":{"order":["Taboada_2016"],"data":{"Taboada_2016":{"label":"Taboada_2016","enumerator":"1","doi":"10.1146/annurev-linguistics-011415-040518","html":"Taboada, M. (2016). Sentiment Analysis: An Overview from Linguistics. <i>Annual Review of Linguistics</i>, <i>2</i>(1), 325–347. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1146/annurev-linguistics-011415-040518\">10.1146/annurev-linguistics-011415-040518</a>","url":"https://doi.org/10.1146/annurev-linguistics-011415-040518"}}}}}