:"code","lang":"python","executable":true,"value":"import numpy as np\nimport pandas as pd\nimport re\nimport nltk\nfrom nltk import word_tokenize\nfrom nltk.stem import WordNetLemmatizer\nfrom nltk.corpus import stopwords\nstop_words = stopwords.words('english')\nimport gensim\nfrom gensim import corpora\nfrom gensim.models import LdaModel","key":"oBjtWGuiRa"},{"type":"outputs","id":"mVbMxXIsNVMardZMTSRHL","children":[],"key":"JRmdZfuPF2"}],"key":"EDaYygg203"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import and examine the data","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NZotVaxJ9D"}],"identifier":"import-and-examine-the-data","label":"Import and examine the data","html_id":"import-and-examine-the-data","implicit":true,"key":"o99txCZ53M"}],"key":"K1S66n67RD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"df = pd.read_csv('./data/gnm_articles.csv', encoding = 'utf-8')","key":"AkqhrwF0H2"},{"type":"outputs","id":"Sza7HTj2SW8xBaJQLxhf9","children":[],"key":"PrEeU02lbk"}],"key":"dgyE9mgQXf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"df.head()","key":"TCRAvqC07x"},{"type":"outputs","id":"nPT1UydG8OtMVWqsIwg0Q","children":[],"key":"qS0H9J11to"}],"key":"ipSYqqwu3o"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define a function to process the article_text column","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JwG2PUM4rX"}],"identifier":"define-a-function-to-process-the-article-text-column","label":"Define a function to process the article_text column","html_id":"define-a-function-to-process-the-article-text-column","implicit":true,"key":"SPldjefZHg"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The only information we are interested in is in the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ysCflrwulV"},{"type":"inlineCode","value":"article_text","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aDUdNbrOdO"},{"type":"text","value":" column, which contains the body of the articles. We will reuse and modify the function from the previous unit to clean up that data. We will:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JSV1lnY29M"}],"key":"Rod8BfPsUw"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Remove the html tokens (the text has ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mi6HdPhSHY"},{"type":"inlineCode","value":"<p>","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"kcFxtPMrji"},{"type":"text","value":" and ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"j1vI2Swxiw"},{"type":"inlineCode","value":"</p>","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"WQd51oCa1v"},{"type":"text","value":" to mark paragraphs)","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rWUsUbvbbf"}],"key":"VWi7Lturtq"}],"key":"eA65TpS7en"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tokenize and lowercase","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"GOiXzP9jG5"}],"key":"Ib92KRSmJ3"}],"key":"lb8sFB4bqN"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Remove stopwords","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"GI6qh7YL2t"}],"key":"KT5gzFQd9z"}],"key":"iv4SYotqh9"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Lemmatize -- this one is added from last time; we use the WordNet lemmatizer","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"HTtQCkloi4"}],"key":"kSpSJTIQFT"}],"key":"OXuQVblkrp"}],"key":"J4lpBiEsbG"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"We apply this function to the original df, to create a new column, ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"Nmj4qlvQZb"},{"type":"inlineCode","value":"article_processed","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"HpHW0FitHh"},{"type":"text","value":". Then, we create a dictionary from that blob of text. You can also first extract the ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"OHLmfPLlWq"},{"type":"inlineCode","value":"article_text","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"ps9c1uiZFx"},{"type":"text","value":" to a string and process it, then create the dictionary (like we did in Unit 11, for processing survey data).","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"ypfWvMw0kd"}],"key":"alBEEPbwQ5"}],"key":"ujJkdEshE7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# define a function that: 1. tokenizes, 2. lowercases and\n# 3. lemmatizes\n\n# create the lemmatizer first\nlemmatizer = WordNetLemmatizer()\n\n# define the function\ndef process_text(text):\n    clean_text = re.sub(r'<.*?>', '', text)\n    words = word_tokenize(clean_text.lower())\n    cleaned_words = [word for word in words if word.isalpha() and word not in stop_words]\n    lemmatized_words = [lemmatizer.lemmatize(word) for word in cleaned_words]\n    return lemmatized_words","key":"W9YCXozKyp"},{"type":"outputs","id":"j5P4tHWY9sobJuUXgLk7f","children":[],"key":"PDpcFVp6i4"}],"key":"mv6N8nlqPJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"df['article_processed'] = df['article_text'].apply(process_text)","key":"b6BSrFlhY0"},{"type":"outputs","id":"yolgq4KOTApKzZaVFuHH7","children":[],"key":"fVjrEKjWEt"}],"key":"z1aaZMzGys"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"df.head()","key":"xCvEgUDuHO"},{"type":"outputs","id":"JGHmMk8CMMay2qcM3_SnP","children":[],"key":"ECWt1G0QMO"}],"key":"kItEzXHct3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Parameters for gensim","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"q9mqGj1mbZ"}],"identifier":"parameters-for-gensim","label":"Parameters for gensim","html_id":"parameters-for-gensim","implicit":true,"key":"cThFSLTIIy"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now that we have clean text, we will process it with gensim functions. The first one creates a dictionary of the words in the text. The second creates a corpus, a bag of words with the frequency of all the words. Finally, the LdaModel actually creates the topic model.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"MouVZGdidj"}],"key":"HyqNXnADrl"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"There are several parameters you can set with LDA models. For instance, you may want to filter out words that have very few instances, because they are only representative of one or two articles. In this case, what we are setting as parameters are the number of topics and the number of iterations. We train the model with 10 topics, that is, we assume that there are 10 topics across the entire dataset. And we do 15 passes.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"BBauBDQnc6"}],"key":"TIBunc1QYi"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Once we have extracted the topics, we can inspect the most representative X words in each topic. In this case, I set it to 20. One thing you could do is to try and label the topics. So, for instance, these are the two top topics when I run the model:","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"d6zjLuDXch"}],"key":"HwqTDVPREg"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":9,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Topic 0: party, liberal, conservative, election, government, harper, minister, political, would, leader, ndp, campaign, prime, new, one, vote, voter, trudeau, could, time","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Y8qYVHtJuB"}],"key":"wvJ4ZcQHIv"}],"key":"xOyZ3syVDh"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"Topic 1: per, cent, government, year, tax, canada, would, health, care, money, system, budget, cost, canadian, one, rate, spending, education, province, country","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"kOfyWmRrcv"}],"key":"uYAxzeKjc6"}],"key":"ZJRil29xwB"}],"key":"NNaBl4rOdA"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"I could rename them to:","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"ALT2eeAxho"}],"key":"CGoahGsCEM"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":15,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Topic 0 = Canadian politics","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"guDBQp9wtI"}],"key":"giyyktpyGt"}],"key":"s9i4FjBVxt"},{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Topic 1 = Budget and government spending","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"PLRxJlb5VP"}],"key":"T6MsNQe2HB"}],"key":"aH9AtOaXEM"}],"key":"BlmAd201Ay"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"The labels in the ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"JuLZtYkvFc"},{"type":"link","url":"https://gendergaptracker.research.sfu.ca/apps/topicmodel","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"Gender Gap Tracker","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"Q0jfF7e7kr"}],"urlSource":"https://gendergaptracker.research.sfu.ca/apps/topicmodel","key":"H70zvtyTPU"},{"type":"text","value":" site are done manually every month.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"J73BmZEbBY"}],"key":"u7HIil6XUi"}],"key":"SKcgphYrZZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# use the gensim function to create a dictionary of the words in the text\ndictionary = corpora.Dictionary(df['article_processed'])","key":"BWb4tF8MVK"},{"type":"outputs","id":"tWM59hNaiBLfBb8Q3BVMu","children":[],"key":"VS6nqEpa48"}],"key":"N1WiDyscNj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# you can inspect the contents of that dictionary\nfor token, token_id in list(dictionary.token2id.items())[:10]:\n    print('{} => {}'.format(token, token_id))","key":"vp1K1JXYH9"},{"type":"outputs","id":"ciFwNmDuzfxnmFp6TDX9o","children":[],"key":"obUJgEx8MJ"}],"key":"kmYQCdAXD3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# use the doc2bow function to create a corpus, a bag of words (bow) of the text and the word counts\ncorpus = [dictionary.doc2bow(text) for text in df['article_processed']]","key":"YNrjx2r5XM"},{"type":"outputs","id":"TwyIzXrXaEvxWCrTzibBS","children":[],"key":"X9RPma20gR"}],"key":"gLPplwcs1m"},{"type":"block","kind":"notebook-code","data":{"scrolled":true},"children":[{"type":"code","lang":"python","executable":true,"value":"# create the LDA model\nlda_model = LdaModel(corpus, num_topics=10, id2word=dictionary, passes=15)","key":"rTzTD7cOmV"},{"type":"outputs","id":"eHew9WAk5iuKo0MjZH1Dx","children":[],"key":"IecTemB13O"}],"key":"Lc3QqhOD7e"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# print the top 20 words for each topic\ntopics = lda_model.print_topics(num_words=20)\nfor topic_num, topic in topics:\n    print(f\"Topic {topic_num}: \", end=\"\")\n    words = topic.split(' + ')\n    word_list = [word.split('*')[1].strip('\\\"') for word in words] \n    print(\", \".join(word_list))\n    print()","key":"CIaw3vSIAO"},{"type":"outputs","id":"-Ov4nuZrpS5HxY0Bswt8b","children":[],"key":"a9eMKsTCHd"}],"key":"ssXxLWAS3e"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# you can also print the weight of each word in the topic\nfor topic_num, topic in topics:\n    print(\"Topic {}:\".format(topic_num), end=\" \")\n    words = topic.split(' + ')\n    word_weight_list = [\"{} ({:.4f})\".format(term.strip('\\\"'), float(weight)) for weight, term in (word.split('*') for word in words)]\n    print(\", \".join(word_weight_list))\n    print()","key":"EYMKFBIh5I"},{"type":"outputs","id":"aNK5rbUA3NVuIjxaS-ndZ","children":[],"key":"ffsxq5MTaE"}],"key":"crXrl2RMs4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YdKSYNSvYC"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"gHmaPj9kdZ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We have learned about topic modelling and how to extract topics from data using the LDA model in the gensim library.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"I9fGcZVhli"}],"key":"swhQ9AlgDc"}],"key":"RJzD7prpKy"}],"key":"z1psHuNjEL"},"references":{"cite":{"order":[],"data":{}}}}