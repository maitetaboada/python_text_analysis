type":"inlineCode","value":"alphabetList[0:3]","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"YmQaz5mFNd"}],"key":"R8GT9qUMDO"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Note that this means “give me the list starting at 0 (included) and ending at 3 (not included)”. Check the output below, where it gives the items 0, 1, and 2 (a, b, c).","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ZZjQS0hMee"}],"key":"fHY5Dh5Sjl"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"You can also just omit the “0” part if you want to start at the beginning:","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"UH8v6YCcbY"}],"key":"UdTLW7G65H"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"children":[{"type":"inlineCode","value":"alphabetList[:3]","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"crIkZ8z2CF"}],"key":"ndrmYUimLV"}],"key":"VnRsIIxxId"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"alphabetList = ['a', 'b', 'c', 'd', 'e', 'f', 'g']","key":"oKrFbI3z1L"},{"type":"outputs","id":"Omym4mec2qYrVD45GzT58","children":[],"key":"itQLTueODY"}],"key":"q12EDlyFVB"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(alphabetList[0])\nprint(alphabetList[1])\nprint(alphabetList[2])","key":"DhbfHR30Kt"},{"type":"outputs","id":"HLQbEVkfWy9awrZl4DB2N","children":[],"key":"todIiIKafn"}],"key":"gPqKqqElGE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"alphabetList[0:3]","key":"VaG44k4ZS5"},{"type":"outputs","id":"5TH8UBc2oqrVxjUGczSDA","children":[],"key":"LNo9vtwleh"}],"key":"r7zkh8NioJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"alphabetList[:3]","key":"E2iz7Bp0r6"},{"type":"outputs","id":"VJCjFnu7VdBzs5JV2_KL-","children":[],"key":"Ks5mdW5rOG"}],"key":"HPSgcLtdCl"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# divide the names list into 3 parts, slicing by the variables above, which tell us how many items\n# is 70%, 20%, 10%\ntrainingNames = labeledNames[:len_training]\ndevtestNames = labeledNames[len_training:(len_training + len_dev)]\ntestNames = labeledNames[(len_training + len_dev):]\n\n# print to double-check\nprint(len(trainingNames))\nprint(len(devtestNames))\nprint(len(testNames))","key":"naqVWhXbd6"},{"type":"outputs","id":"uVzxQ3miBVsS7RGaTHt9H","children":[],"key":"XRcAmJdGJr"}],"key":"oSAgPJANf3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Define a feature extraction function","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"tyS7Nhrk0y"}],"identifier":"define-a-feature-extraction-function","label":"Define a feature extraction function","html_id":"define-a-feature-extraction-function","implicit":true,"key":"iOOWUyKhqp"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"The main step in supervised machine learning (and in supervised text classification) is to define the features that you think will be relevant. In this case, I think the last letter of the name is important to guess whether a man or a woman is more likely to have that name.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"KlnNqzczEn"}],"key":"ceFPYa8yj1"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Then, we’ll define a feature extractor function that returns the last letter of the name. The function returns a dictionary of all the names, where the key is “suffix” and the value is the last letter in the name.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"yJguaDRPbM"}],"key":"zRVnFF9Akw"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Once we define the function, we can ","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"LtVraSkNh7"},{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"call the function","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"JooIQ091vi"}],"key":"vAWnblFvBU"},{"type":"text","value":", that is, we can use it, to go through all the names in each of the 3 data sets, and extract features (i.e., the last letter) from all the names in the list.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"fJjNCT3YXk"}],"key":"XNh0jYmUA0"}],"key":"hNlhvESlS0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# define the function\ndef featureExtractor(name):\n    # name[-1] will select the last letter of the name\n    return {'suffix1': name[-1:]}","key":"m7eXOJEPhr"},{"type":"outputs","id":"JFbRnKzAtql6_i2nNAKN6","children":[],"key":"SaV3BDF3zd"}],"key":"gdr8JKR8Fc"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# call the function to extract the features from each set\ntrainingSet = [(featureExtractor(n), gender) for (n, gender) in trainingNames]\ndevtestSet = [(featureExtractor(n), gender) for (n, gender) in devtestNames]\ntestSet = [(featureExtractor(n), gender) for (n, gender) in testNames]","key":"qJ1CRplhJq"},{"type":"outputs","id":"tv0iMY4149LJSTOUuDCeA","children":[],"key":"UPdlxt9Rmo"}],"key":"mvyofHOxrh"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# check the contents of trainingSet\n# you'll see that the names have been reduced to a letter\n\ntrainingSet","key":"bpRWMlfvUC"},{"type":"outputs","id":"TP28N4Zx9-XPlkClivbCy","children":[],"key":"TrLpUrPCPq"}],"key":"GYo0j8qRXm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Train a classifier","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"LgjSyREoGN"}],"identifier":"train-a-classifier","label":"Train a classifier","html_id":"train-a-classifier","implicit":true,"key":"fzYKfeyLRO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now that we have our various datasets, we can start training our model using the training set. We will be using a “naive Bayes” classifier which you can read more about in ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"viZak9629U"},{"type":"link","url":"https://www.nltk.org/book/ch06.html#naive-bayes-classifiers","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Section 5 of Chapter 6 in the NLTK book","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"g72C6WSFX7"}],"urlSource":"https://www.nltk.org/book/ch06.html#naive-bayes-classifiers","key":"yIcqtoIoW8"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jD5v2aObI2"}],"key":"Hr5iNHscfO"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Then, we run an NLTK function to give us the accuracy of the classifier in the devtestSet.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Ln9jF76EqU"}],"key":"agtT0R1Yfr"},{"type":"paragraph","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"text","value":"Finally, you can go and see which features the classifier uses, the most informative features.","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"YYJ2wfSytR"}],"key":"lrDjDJWidm"}],"key":"Lg9aaQG2Ju"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# run the classifier with the trainingSet\nclassifier = nltk.NaiveBayesClassifier.train(trainingSet)\n\n# check accuracy on the devtestSet\nprint(\"Accuracy on the dev-test set:\", nltk.classify.accuracy(classifier, devtestSet), \"\\n\")\n\n# check what the most informative features are in our model\nclassifier.show_most_informative_features(5)","key":"WHZ8wwkXlG"},{"type":"outputs","id":"tEbfyVr-GFU-NgsIpB4tz","children":[],"key":"wx0cCSyuif"}],"key":"fwieCcbx8K"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Checking the features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eIZRDZExKF"}],"identifier":"checking-the-features","label":"Checking the features","html_id":"checking-the-features","implicit":true,"key":"IrcZCwxkbE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"As you can see above, names ending in ‘a’ are predominantly female according to our classifier and names ending in ‘k’ are mostly male. To improve our model, we will generate a list of names that our classifier gets wrong using the devtestSet.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xwlwWxApHV"}],"key":"Gdsp68kbZA"}],"key":"w2ouvhx9wz"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# create an empty list to store the errors\nerrors = []\n\n# loop through the devtestNames to classify the entire name\n# store the errors in the list\nfor (name, tag) in devtestNames:\n    guess = classifier.classify(featureExtractor(name))\n    if guess != tag:\n        print(\"correct=%s guess=%s name=%s\" % (tag, guess, name))","key":"tZtKP4hI4R"},{"type":"outputs","id":"QCNQmTd8SOirMYAbK8gpb","children":[],"key":"d4O3UHd7pp"}],"key":"DL8xgSs9vw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Adjusting the features","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M8OtNbMlEc"}],"identifier":"adjusting-the-features","label":"Adjusting the features","html_id":"adjusting-the-features","implicit":true,"key":"qnm0u3PStn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Remember that our classifier only looks at the the last letter of each name. From this list, however, we see that sometimes the last two letters are a better indicator of gender. This is because names ending in ‘yn’ or ‘en’ are mostly female, even though most names ending in ‘n’ are male. This tells us that we should add another feature to our model to improve it. This second feature will be the second to last letter of the name.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lvzvqtKtwR"}],"key":"Oc11N89pa9"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"So we write a new feature extractor function, which expands the dictionary to include the last letter and the last-but-one letter (the penultimate letter).","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pkOoNBPg0G"}],"key":"vBCQBZN8fW"}],"key":"gHN3Mill3L"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def featureExtractor2(name):\n    # suffix1 returns the last letter of the name and suffix2 returns the last two letters\n    return {'suffix1': name[-1:], 'suffix2': name[-2:]}","key":"bUYwsiJjB1"},{"type":"outputs","id":"K9Ks_BKJAN3_bQqv3p85h","children":[],"key":"C75DEhXszz"}],"key":"F0SPaJLmRu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Training a new classifier","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QauhOjL1sr"}],"identifier":"training-a-new-classifier","label":"Training a new classifier","html_id":"training-a-new-classifier","implicit":true,"key":"SREo998gVV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now that we created a second feature extractor, let’s re-train our model before we can finally test it on our test set.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WujRD1vuks"}],"key":"T4g8WfWp96"}],"key":"xlc8MOq1Vb"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"trainingSet2 = [(featureExtractor2(n), gender) for (n, gender) in trainingNames]\ndevtestSet2 = [(featureExtractor2(n), gender) for (n, gender) in devtestNames]\ntestSet2 = [(featureExtractor2(n), gender) for (n, gender) in testNames]","key":"v1doWYcWCH"},{"type":"outputs","id":"xM-WzkhdsnRqUJTUqqaPu","children":[],"key":"GQqelz1iXL"}],"key":"Wgm28nFqP7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"classifier2 = nltk.NaiveBayesClassifier.train(trainingSet2)\nprint(\"Accuracy on the dev-test set:\", nltk.classify.accuracy(classifier2, devtestSet2))","key":"APMdVlXBXY"},{"type":"outputs","id":"U6w2C1tTNnpqG2Al0c-n0","children":[],"key":"RLzQq3YHvD"}],"key":"r6vLTE3zNf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Testing on test set","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MPzN78GnsE"}],"identifier":"testing-on-test-set","label":"Testing on test set","html_id":"testing-on-test-set","implicit":true,"key":"g8wuC2ZGHT"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"As you can see, our model improved by about 2% by adding one extra feature. But we need to remember that we are only testing on our devtestSet here. This is the set that we investigated and optimized for.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JKqP70C74M"}],"key":"UtR5pmZRZl"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"In order to really know how our model is doing, we need to test it on data that it has never seen before. This is why we have a testSet which we do not use until our model is finalized. Let’s run this final model on our testSet and see the actual expected accuracy of our model.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"t9diGluY1O"}],"key":"FJwgsU8ySh"}],"key":"gUYji3gBN1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"print(\"Accuracy on the test set:\", nltk.classify.accuracy(classifier2, testSet2))","key":"BgBYOLYHQi"},{"type":"outputs","id":"cm0C6w6O-8EFOFhEP0h9l","children":[],"key":"MJSqBIXYDS"}],"key":"d5HKDqpmRL"},{"type":"block","kind":"notebook-content","ch