C"}],"key":"xZp6vq9wNp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"6) Switch Kernel","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ndAv7GpGMs"}],"identifier":"id-6-switch-kernel","label":"6) Switch Kernel","html_id":"id-6-switch-kernel","implicit":true,"key":"lZKZupc4mB"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"In each notebook, choose Kernel → Change/Select Kernel → Python (LING-ENV).","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"US8HGqvRGg"}],"key":"Iotv6gN621"},{"type":"image","url":"/switch_kernel-d677719c50fbe11ba0ce747a52586fc7.png","alt":"change_kernal","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"xSgsT7q9aD","urlSource":"img/switch_kernel.png"}],"key":"VzH2fQEt8J"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"5) Quick verification","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lWkkfq1YHN"}],"identifier":"id-5-quick-verification","label":"5) Quick verification","html_id":"id-5-quick-verification","implicit":true,"key":"PYL0edTQlY"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Run the following code when you are in LING-ENV.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jeqAQzbmDd"}],"key":"K8CgK3BWVk"}],"key":"HhrWktrQ5P"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import sys, os, importlib, spacy, nltk\nenv = os.environ.get(\"CONDA_DEFAULT_ENV\") or os.path.basename(sys.prefix)\nprint(\"Python:\", sys.version.split()[0])\nprint(\"Env:\", env)\nprint(\"Kernel:\", sys.executable)\n\nfor name in (\"numpy\",\"pandas\",\"sklearn\",\"matplotlib\",\"seaborn\",\n             \"nltk\",\"spacy\",\"wordcloud\",\"tqdm\",\"regex\",\"ipykernel\",\"jupyterlab\"):\n    try:\n        m = importlib.import_module(name)\n        print(f\"{name:12s}\", getattr(m, \"__version__\", \"?\"))\n    except Exception as e:\n        raise SystemExit(f\"❌ Missing or broken package '{name}': {e}\")\n\ntry:\n    spacy.load(\"en_core_web_sm\"); print(\"spaCy model: en_core_web_sm ✅\")\nexcept Exception as e:\n    raise SystemExit(f\"❌ Missing spaCy model: {e}\")\n\nfor pkg, where in [(\"punkt\",\"tokenizers/punkt\"), (\"stopwords\",\"corpora/stopwords\")]:\n    try: nltk.data.find(where); print(f\"NLTK data: {pkg} ✅\")\n    except LookupError: raise SystemExit(f\"❌ Missing NLTK data '{pkg}'. See setup instructions.\")\nprint(\"✅ Environment check passed.\")\n","key":"GYwi8Tyb2L"},{"type":"outputs","id":"dcbRwGAI2l0iPozs63cI4","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Python: 3.11.13\nEnv: base\nKernel: /opt/anaconda3/envs/ling-env/bin/python\nnumpy        1.26.4\npandas       2.3.3\nsklearn      1.7.2\nmatplotlib   3.10.6\nseaborn      0.13.2\nnltk         3.9.2\nspacy        3.8.7\nwordcloud    1.9.4\ntqdm         4.67.1\nregex        2.5.162\nipykernel    6.30.1\njupyterlab   4.4.9\nspaCy model: en_core_web_sm ✅\nNLTK data: punkt ✅\nNLTK data: stopwords ✅\n✅ Environment check passed.\n"},"children":[],"key":"nzZpFqoby3"}],"key":"Mxw0Y95mx2"}],"key":"xuohHFlobY"}],"key":"Zqbk6zzGo9"},"references":{"cite":{"order":[],"data":{}}}}