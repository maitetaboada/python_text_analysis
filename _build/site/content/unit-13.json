~ronkowit/eliza.html","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Kenneth Ronkowitz","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"cmyfZgclys"}],"urlSource":"https://web.njit.edu/~ronkowit/eliza.html","key":"wYW8suYvfZ"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AbaLCEZxCJ"}],"key":"nuLS79Josb"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"ELIZA was built to mimick a particular type of therapist: someone who asks you further questions about what you are saying. The answers where like this:","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"EsFdAYEJmg"}],"key":"gh097iZNjB"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":7,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Human: Well, my boyfriend made me come here.","key":"jaOupNtatz"}],"key":"GsG4s75mxC"}],"key":"TXEyvTBIe4"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Eliza: Your boyfriend made you come here","key":"MmjpAqLLzR"}],"key":"HEdNpF02pG"}],"key":"G0QGznREh5"},{"type":"listItem","spread":true,"position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Human: He says I’m depressed much of the time.","key":"BCb0vs8N5R"}],"key":"Cror1ebvo3"}],"key":"MF61kmdETT"},{"type":"listItem","spread":true,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Eliza: I am sorry to hear you are depressed","key":"MWdzwJSVGX"}],"key":"FD5C1NhNl8"}],"key":"Sa2Y1O63Gz"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Human: It’s true. I am unhappy.","key":"R63cBcNRgB"}],"key":"ZzY3JlfyhJ"}],"key":"lNLYEMnLbH"},{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Eliza: Do you think coming here will help you not to be unhappy","key":"OPGR2WlUGW"}],"key":"jHbZ6aG3Co"}],"key":"ckvhrkpUPt"},{"type":"listItem","spread":true,"position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Human: I need some help, that much seems certain","key":"PvNUIPqGqQ"}],"key":"x1jUQzIMCc"}],"key":"PTDu23wPpc"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Eliza: What would it mean to you if you got some help","key":"wnKNIYxszh"}],"key":"Gpw0DbIwhe"}],"key":"WmtejVPXR0"}],"key":"s20s8sOcHM"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Text is from Weizenbaum, J. (1966). ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"XHtI4JEPRR"},{"type":"cite","url":"https://dl.acm.org/doi/10.1145/365153.365168","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"ELIZA—a computer program for the study of natural language communication between man and machine","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"WPbSFMwm0i"}],"kind":"narrative","label":"Weizenbaum_1966","identifier":"https://dl.acm.org/doi/10.1145/365153.365168","enumerator":"1","key":"bgoOauJLMF"},{"type":"text","value":". ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"H6OarbqI5Q"},{"type":"emphasis","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Communications of the ACM","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"HCvYlYT6XE"}],"key":"kqCDmtxA1H"},{"type":"text","value":", 9(1), 36-45.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"slAQUMyIfj"}],"key":"IIi7OiUkyc"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"You can see that you can create the answers by using pattern matching, introducing things like “I am sorry you are X”, when X is in a pre-defined list of negative mental states.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"nt8CSnRTU3"}],"key":"b6UukkdMc5"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Today, chatbots range from speech-to-speech systems like Siri, Alexa, Cortana and the like, to text-based chatbots that you may find on your bank’s website. Full conversational systems like Siri need to incorporate speech processing, language understanding, plus a way of getting answers to you (usually by searching the web). Customer service chatbots just need a language model to understand and generate language, plus a database that contains company information that the customer may need.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"GglVmrKJ1L"}],"key":"Y7CjXoIpUE"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"You can also build a chatbot that ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"QZDd8vER5c"},{"type":"link","url":"https://www.youtube.com/watch?v=zZOzKQPSrDo","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"retrieves answers from a corpus","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"wueLeJbUCp"}],"urlSource":"https://www.youtube.com/watch?v=zZOzKQPSrDo","key":"rk822Gc8Gu"},{"type":"text","value":", or one based on generative AI, which ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"QmCLM6eBGT"},{"type":"link","url":"https://www.youtube.com/watch?v=GB3dOuV6f4s","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"generates answers","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"fhQvNDqGvm"}],"urlSource":"https://www.youtube.com/watch?v=GB3dOuV6f4s","key":"E4Pek0d0DO"},{"type":"text","value":" by encoding your question.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"KsGBSQ3n1L"}],"key":"PZCfTkRsT8"}],"key":"gFE3WulOGA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pattern-matching chatbot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lIfc6MhUHD"}],"identifier":"pattern-matching-chatbot","label":"Pattern-matching chatbot","html_id":"pattern-matching-chatbot","implicit":true,"key":"ITiCZXlgzh"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"You can build a simple chatbot by storing a series of potential questions and answers. That is, “if the user says X, then answer Y”. We are going to try that here. We will use spaCy’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"N38I1VbRIT"},{"type":"link","url":"https://spacy.io/usage/rule-based-matching","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Matcher","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Yik2ifBM01"}],"urlSource":"https://spacy.io/usage/rule-based-matching","key":"JynJR2zBxf"},{"type":"text","value":" module to do that.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rAHv4UpNWr"}],"key":"xumz1fX1od"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This particular implementation is based on ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mCWZkvLeNP"},{"type":"link","url":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Ahilya’s","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Spj1zpzAmg"}],"urlSource":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","key":"NBNWsdupJP"},{"type":"text","value":". It produces an extremely simple dialogue; just a greeting and only in response to “hello”. You can extend it with other patterns.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bc3QJF9LFV"}],"key":"IUCNmaTAb5"}],"key":"KsGgsZ2p9y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import statements and load spaCy","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SrRNkmAAxk"}],"identifier":"import-statements-and-load-spacy","label":"Import statements and load spaCy","html_id":"import-statements-and-load-spacy","implicit":true,"key":"inQlC4eJjh"}],"key":"um4fmT1ZYe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import spacy\nfrom spacy.matcher import Matcher\n\nnlp = spacy.load(\"en_core_web_sm\")","key":"TdY4cMx6kh"},{"type":"outputs","id":"LrKlXntrZ_IBDd_o7SwIL","children":[{"type":"output","jupyter_data":{"ename":"RuntimeError","evalue":"module compiled against API version 0xf but this version of numpy is 0xd","output_type":"error","traceback":"\u001b[1;31m---------------------------------------------------------------------------\u001b[0m\n\u001b[1;31mRuntimeError\u001b[0m                              Traceback (most recent call last)\n\u001b[1;31mRuntimeError\u001b[0m: module compiled against API version 0xf but this version of numpy is 0xd"},"children":[],"key":"XhKr1Xnuy1"}],"key":"iouWnSAAss"}],"key":"ugmKhs9sLE"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create the chatbot matching","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iFCpliUNdD"}],"identifier":"create-the-chatbot-matching","label":"Create the chatbot matching","html_id":"create-the-chatbot-matching","implicit":true,"key":"s2c4UMnEvY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The code has 2 parts:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KHIqA32qB0"}],"key":"QTiL1q38y4"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a few patterns, such as “Greeting” = “hello”","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ejhqc7I9pY"}],"key":"D5bpoddwPZ"}],"key":"sz1Aim8Y0w"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do a loop to get the input (parsing it with spaCy) and produce output","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"WqP9Udc6OY"}],"key":"QhPrlCZtaX"}],"key":"JTcHGyXZm7"}],"key":"X8g7xSlKZO"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"At any point, when you are done, type ‘quit’ to leave the dialogue.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"ykz0QKKUm4"}],"key":"z2dLb3JuSZ"}],"key":"ygt2BCCIwy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# set up the matcher to recognize specific patterns\nmatcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}]])\n\n# define the chatbot's interaction loop\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": # type 'quit' to exit the prompt below\n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            print(\"Bot: Hello there!\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"UwgD2cqXw1"},{"type":"outputs","id":"VOgfqV5KcMwj6dYcHjv8P","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"You: hello\nBot: Hello there!\nYou: hi\nBot: I'm sorry, can you please rephrase?\nYou: good morning!\nBot: I'm sorry, can you please rephrase?\nYou: quit\n"},"children":[],"key":"A5bfvFBqUi"}],"key":"NJY1xBen28"}],"key":"fqVpERQpSV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Add more rules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Mm1gSsfFm0"}],"identifier":"add-more-rules","label":"Add more rules","html_id":"add-more-rules","implicit":true,"key":"cWXvKTsqaE"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We are adding also “hi” to the list of Greetings, and giving a slightly different answer if “hi” is said, instead of “hello”. Then we add a new type of interaction, “Help_request”, where the system catches any instance of the word “help” in the prompt and answers. Finally, we add a default answer, where the bot doesn’t match anything, so that the user rephrases.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"l7sTsKiW1l"}],"key":"YLK4Flss6m"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Play around with this and add as many types of rules and as many matches as you want.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"oUzY2ZKiS8"}],"key":"avrCX8GiWa"}],"key":"EVIZbjxeoQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"matcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}], [{\"LOWER\": \"hi\"}], [{\"LOWER\": \"morning\"}]])\nmatcher.add(\"Help_request\", [[{\"LOWER\": \"help\"}]]) \n\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": \n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            if \"hello\" in message.lower():\n                print(\"Bot: Hello there!\")\n            elif \"hi\" in message.lower():\n                print(\"Bot: Hey! How's it going?\")\n            elif \"morning\" in message.lower():\n                print(\"Bot: Good morning!\")\n            elif \"help\" in message.lower():\n                print(\"Bot: What can I help you with?\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"Wpe2eamKHc"},{"type":"outputs","id":"qFfNg3xytFVbw8pWdgbWV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"You: hello\nBot: Hello there!\nYou: hello\nBot: Hello there!\nYou: hi\nBot: Hey! How's it going?\nYou: hello\nBot: Hello there!\nYou: quit\n"},"children":[],"key":"eJXVXFYBZa"}],"key":"Rp9tGlEcRt"}],"key":"Y10bxUiD56"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dP5G1rPc5s"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"yMg2pCGYTB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We have learned about simple chatbots and started a pattern-matching chatbot. Check the Canvas page for more links to other types of chatbots.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XUxlH6zJgR"}],"key":"ABPQOelOeY"}],"key":"FQPbFkGywq"}],"key":"GGDEttdYEZ"},"references":{"cite":{"order":["Weizenbaum_1966"],"data":{"Weizenbaum_1966":{"label":"Weizenbaum_1966","enumerator":"1","doi":"10.1145/365153.365168","html":"Weizenbaum, J. (1966). ELIZA—a computer program for the study of natural language communication between man and machine. <i>Communications of the ACM</i>, <i>9</i>(1), 36–45. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1145/365153.365168\">10.1145/365153.365168</a>","url":"https://doi.org/10.1145/365153.365168"}}}}}