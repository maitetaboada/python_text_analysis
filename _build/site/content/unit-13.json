n":[{"type":"text","value":"Matcher","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"baHQX0ry5f"}],"urlSource":"https://spacy.io/usage/rule-based-matching","key":"hs9bxMzSpz"},{"type":"text","value":" module to do that.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HWl9K07paX"}],"key":"ZlDPOFGGCn"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This particular implementation is based on ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"fk2LlBkQIJ"},{"type":"link","url":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Ahilya’s","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"SBFGCOogTg"}],"urlSource":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","key":"gNI9BGVysC"},{"type":"text","value":". It produces an extremely simple dialogue; just a greeting and only in response to “hello”. You can extend it with other patterns.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"axPwMCZWKx"}],"key":"W173tJign8"}],"key":"Cj1UhqPfbl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import statements and load spaCy","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Bls8pNn9WP"}],"identifier":"import-statements-and-load-spacy","label":"Import statements and load spaCy","html_id":"import-statements-and-load-spacy","implicit":true,"key":"MpU9wanVXS"}],"key":"PQhusTot1x"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import spacy\nfrom spacy.matcher import Matcher\n\nnlp = spacy.load(\"en_core_web_sm\")","key":"cppSOrebGc"},{"type":"outputs","id":"VoWdHWYYGDOmhAnOVqC6_","children":[{"type":"output","jupyter_data":{"ename":"RuntimeError","evalue":"module compiled against API version 0xf but this version of numpy is 0xd","output_type":"error","traceback":"\u001b[1;31m---------------------------------------------------------------------------\u001b[0m\n\u001b[1;31mRuntimeError\u001b[0m                              Traceback (most recent call last)\n\u001b[1;31mRuntimeError\u001b[0m: module compiled against API version 0xf but this version of numpy is 0xd"},"children":[],"key":"ICnLAVQfNo"}],"key":"KjqIBaLGzM"}],"key":"W2JfV40H7i"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create the chatbot matching","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"S3XGhmw8NN"}],"identifier":"create-the-chatbot-matching","label":"Create the chatbot matching","html_id":"create-the-chatbot-matching","implicit":true,"key":"VfYa3JZW8d"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The code has 2 parts:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hd4gLFwk0T"}],"key":"GXiPPKoc1K"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a few patterns, such as “Greeting” = “hello”","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"H81ArDZyWW"}],"key":"PPMgTnRpCb"}],"key":"vIO7KuQMe3"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do a loop to get the input (parsing it with spaCy) and produce output","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"Oqr3n4L5bH"}],"key":"glkGUABT8Z"}],"key":"dlIsQh3hFZ"}],"key":"dGN1dLFO2i"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"At any point, when you are done, type ‘quit’ to leave the dialogue.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"Z2DKttNFx2"}],"key":"YGPcrERL0h"}],"key":"Ijd2KRHCM7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# set up the matcher to recognize specific patterns\nmatcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}]])\n\n# define the chatbot's interaction loop\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": # type 'quit' to exit the prompt below\n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            print(\"Bot: Hello there!\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"RPpNpwtVuE"},{"type":"outputs","id":"v0K_A41Q49QOKq0Xe76lK","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"You: hello\nBot: Hello there!\nYou: hi\nBot: I'm sorry, can you please rephrase?\nYou: good morning!\nBot: I'm sorry, can you please rephrase?\nYou: quit\n"},"children":[],"key":"TssDQ7uMPt"}],"key":"d0DgdFnGNg"}],"key":"VCIFO4gl1D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Add more rules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Xk0M2k4qMJ"}],"identifier":"add-more-rules","label":"Add more rules","html_id":"add-more-rules","implicit":true,"key":"sxMyrJcnTO"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We are adding also “hi” to the list of Greetings, and giving a slightly different answer if “hi” is said, instead of “hello”. Then we add a new type of interaction, “Help_request”, where the system catches any instance of the word “help” in the prompt and answers. Finally, we add a default answer, where the bot doesn’t match anything, so that the user rephrases.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"s4Icm6CECQ"}],"key":"O3PoMd75S8"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Play around with this and add as many types of rules and as many matches as you want.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ecKtw1GK9O"}],"key":"WTIQxCAgoD"}],"key":"bLw9V2RK4w"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"matcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}], [{\"LOWER\": \"hi\"}], [{\"LOWER\": \"morning\"}]])\nmatcher.add(\"Help_request\", [[{\"LOWER\": \"help\"}]]) \n\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": \n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            if \"hello\" in message.lower():\n                print(\"Bot: Hello there!\")\n            elif \"hi\" in message.lower():\n                print(\"Bot: Hey! How's it going?\")\n            elif \"morning\" in message.lower():\n                print(\"Bot: Good morning!\")\n            elif \"help\" in message.lower():\n                print(\"Bot: What can I help you with?\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"zJP2ajXEFC"},{"type":"outputs","id":"LpFabWRDMeQz0MkbJXhJv","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"You: hello\nBot: Hello there!\nYou: hello\nBot: Hello there!\nYou: hi\nBot: Hey! How's it going?\nYou: hello\nBot: Hello there!\nYou: quit\n"},"children":[],"key":"Vk23wVyD9d"}],"key":"zkhayiFobv"}],"key":"PFA8zmGHL3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZyHnNlBqvV"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"PHN6snbXd9"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We have learned about simple chatbots and started a pattern-matching chatbot. Check the Canvas page for more links to other types of chatbots.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZbWdM4lP2h"}],"key":"teliYgl71i"}],"key":"h8osGuCSjH"}],"key":"YqTpZEMUoc"},"references":{"cite":{"order":["Weizenbaum_1966"],"data":{"Weizenbaum_1966":{"label":"Weizenbaum_1966","enumerator":"1","doi":"10.1145/365153.365168","html":"Weizenbaum, J. (1966). ELIZA—a computer program for the study of natural language communication between man and machine. <i>Communications of the ACM</i>, <i>9</i>(1), 36–45. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1145/365153.365168\">10.1145/365153.365168</a>","url":"https://doi.org/10.1145/365153.365168"}}}}}