"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"retrieves answers from a corpus","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"rxHiPR0xST"}],"urlSource":"https://www.youtube.com/watch?v=zZOzKQPSrDo","key":"gtPPlQHq4M"},{"type":"text","value":", or one based on generative AI, which ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Wh5kforUnv"},{"type":"link","url":"https://www.youtube.com/watch?v=GB3dOuV6f4s","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"generates answers","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"MtgyVVH63o"}],"urlSource":"https://www.youtube.com/watch?v=GB3dOuV6f4s","key":"mgbweP65Kq"},{"type":"text","value":" by encoding your question.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"DqdnCBLBG8"}],"key":"kHUhQQXCMA"}],"key":"sq50JxtWD0"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pattern-matching chatbot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WZoNInwJIQ"}],"identifier":"pattern-matching-chatbot","label":"Pattern-matching chatbot","html_id":"pattern-matching-chatbot","implicit":true,"key":"cYc6Uc8gUm"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"You can build a simple chatbot by storing a series of potential questions and answers. That is, “if the user says X, then answer Y”. We are going to try that here. We will use spaCy’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"OyPxtsvMre"},{"type":"link","url":"https://spacy.io/usage/rule-based-matching","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Matcher","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"R2JaFvdwWC"}],"urlSource":"https://spacy.io/usage/rule-based-matching","key":"dVloRREaNj"},{"type":"text","value":" module to do that.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hshVmcsHNv"}],"key":"VXorxNRf9v"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This particular implementation is based on ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"VZjoLe9Hyn"},{"type":"link","url":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Ahilya’s","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"iHf3D6pcy1"}],"urlSource":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","key":"Vs0FbAAiLF"},{"type":"text","value":". It produces an extremely simple dialogue; just a greeting and only in response to “hello”. You can extend it with other patterns.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"FcGI56jCvQ"}],"key":"V5GeZhpngS"}],"key":"S0nKpIIaKV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import statements and load spaCy","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"pCAc8QHS81"}],"identifier":"import-statements-and-load-spacy","label":"Import statements and load spaCy","html_id":"import-statements-and-load-spacy","implicit":true,"key":"cRnL2OS7vq"}],"key":"wX5VtE7yos"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import spacy\nfrom spacy.matcher import Matcher\n\nnlp = spacy.load(\"en_core_web_sm\")","key":"q7fZ9PCjuv"},{"type":"outputs","id":"fO4EoFqc2PP9qWzqAWBGQ","children":[{"type":"output","jupyter_data":{"ename":"RuntimeError","evalue":"module compiled against API version 0xf but this version of numpy is 0xd","output_type":"error","traceback":"\u001b[1;31m---------------------------------------------------------------------------\u001b[0m\n\u001b[1;31mRuntimeError\u001b[0m                              Traceback (most recent call last)\n\u001b[1;31mRuntimeError\u001b[0m: module compiled against API version 0xf but this version of numpy is 0xd"},"children":[],"key":"eW23Iz5vXr"}],"key":"zmoIkXN67d"}],"key":"kP3PNhDP0P"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create the chatbot matching","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qM8AzEorQW"}],"identifier":"create-the-chatbot-matching","label":"Create the chatbot matching","html_id":"create-the-chatbot-matching","implicit":true,"key":"UFrxf5FBJt"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The code has 2 parts:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mVXoXHVcNs"}],"key":"tz4Xsf4045"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a few patterns, such as “Greeting” = “hello”","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"HjsXKMA016"}],"key":"oPs07X4ArR"}],"key":"B6wXTw31qJ"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do a loop to get the input (parsing it with spaCy) and produce output","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"QJad6xa85Q"}],"key":"ZiVBtsPjrK"}],"key":"fVREjVuLel"}],"key":"G2YaL513Du"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"At any point, when you are done, type ‘quit’ to leave the dialogue.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"mVrFgggyhi"}],"key":"pLOxLzp18Y"}],"key":"ZjvSWizINo"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# set up the matcher to recognize specific patterns\nmatcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}]])\n\n# define the chatbot's interaction loop\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": # type 'quit' to exit the prompt below\n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            print(\"Bot: Hello there!\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"GwXGYlvvbd"},{"type":"outputs","id":"6pOp1sqzouadmoYa23Iax","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"You: hello\nBot: Hello there!\nYou: hi\nBot: I'm sorry, can you please rephrase?\nYou: good morning!\nBot: I'm sorry, can you please rephrase?\nYou: quit\n"},"children":[],"key":"w9EjWJM6IT"}],"key":"Bl9tu6eWkk"}],"key":"hy0eekuKlp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Add more rules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZIn7FYyHWx"}],"identifier":"add-more-rules","label":"Add more rules","html_id":"add-more-rules","implicit":true,"key":"GDAXzfvMKI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We are adding also “hi” to the list of Greetings, and giving a slightly different answer if “hi” is said, instead of “hello”. Then we add a new type of interaction, “Help_request”, where the system catches any instance of the word “help” in the prompt and answers. Finally, we add a default answer, where the bot doesn’t match anything, so that the user rephrases.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tM3o1HnBMd"}],"key":"gBvYqsxrmM"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Play around with this and add as many types of rules and as many matches as you want.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Zqcqtko2Ve"}],"key":"EyyZVlNP8Y"}],"key":"S6bOYexTts"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"matcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}], [{\"LOWER\": \"hi\"}], [{\"LOWER\": \"morning\"}]])\nmatcher.add(\"Help_request\", [[{\"LOWER\": \"help\"}]]) \n\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": \n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            if \"hello\" in message.lower():\n                print(\"Bot: Hello there!\")\n            elif \"hi\" in message.lower():\n                print(\"Bot: Hey! How's it going?\")\n            elif \"morning\" in message.lower():\n                print(\"Bot: Good morning!\")\n            elif \"help\" in message.lower():\n                print(\"Bot: What can I help you with?\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"cIkPvReaFf"},{"type":"outputs","id":"9Z_S29SJtRdUgGLOY9OJ-","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"You: hello\nBot: Hello there!\nYou: hello\nBot: Hello there!\nYou: hi\nBot: Hey! How's it going?\nYou: hello\nBot: Hello there!\nYou: quit\n"},"children":[],"key":"Dqug8Pj5Kw"}],"key":"zhgtH4beS6"}],"key":"Cv5weRosub"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"fsAK3jCvdi"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"mi1Ha6VSkP"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We have learned about simple chatbots and started a pattern-matching chatbot. Check the Canvas page for more links to other types of chatbots.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JaTzKk9b2m"}],"key":"SUgT1Jeegn"}],"key":"yYZal7iXUd"}],"key":"FR9IU16XJ9"},"references":{"cite":{"order":["Weizenbaum_1966"],"data":{"Weizenbaum_1966":{"label":"Weizenbaum_1966","enumerator":"1","doi":"10.1145/365153.365168","html":"Weizenbaum, J. (1966). ELIZA—a computer program for the study of natural language communication between man and machine. <i>Communications of the ACM</i>, <i>9</i>(1), 36–45. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1145/365153.365168\">10.1145/365153.365168</a>","url":"https://doi.org/10.1145/365153.365168"}}}}}