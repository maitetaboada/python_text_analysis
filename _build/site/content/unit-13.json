olumn":1},"end":{"line":16,"column":1}},"key":"ZEZZvgk0Bm"},{"type":"emphasis","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"text","value":"Communications of the ACM","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"IfCUTHaQgJ"}],"key":"YF8HVNHqXd"},{"type":"text","value":", 9(1), 36-45.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"FQPJfdScmp"}],"key":"iPAxO77Qey"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"You can see that you can create the answers by using pattern matching, introducing things like “I am sorry you are X”, when X is in a pre-defined list of negative mental states.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"PtzVBriQYm"}],"key":"omt7TTYSV6"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"Today, chatbots range from speech-to-speech systems like Siri, Alexa, Cortana and the like, to text-based chatbots that you may find on your bank’s website. Full conversational systems like Siri need to incorporate speech processing, language understanding, plus a way of getting answers to you (usually by searching the web). Customer service chatbots just need a language model to understand and generate language, plus a database that contains company information that the customer may need.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"kRsipj9IN3"}],"key":"FgoN1fX5NI"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"You can also build a chatbot that ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"UTpqVuwrlc"},{"type":"link","url":"https://www.youtube.com/watch?v=zZOzKQPSrDo","position":{"start":{"line":22,