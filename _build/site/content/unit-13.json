the customer may need.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"m1MA0DKRxN"}],"key":"KMuxQWCMZl"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"You can also build a chatbot that ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Rmvx9Eatf3"},{"type":"link","url":"https://www.youtube.com/watch?v=zZOzKQPSrDo","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"retrieves answers from a corpus","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"Jr9PUNrSXM"}],"urlSource":"https://www.youtube.com/watch?v=zZOzKQPSrDo","key":"yl0idlLGoi"},{"type":"text","value":", or one based on generative AI, which ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"ge2uQopZvn"},{"type":"link","url":"https://www.youtube.com/watch?v=GB3dOuV6f4s","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"generates answers","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"D8Qp7D1QRJ"}],"urlSource":"https://www.youtube.com/watch?v=GB3dOuV6f4s","key":"VTr2fHCgCA"},{"type":"text","value":" by encoding your question.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"xXCuN6SP7U"}],"key":"RhiAVWi8tj"}],"key":"zKGy1LzIGL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Pattern-matching chatbot","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BfHtBiITtg"}],"identifier":"pattern-matching-chatbot","label":"Pattern-matching chatbot","html_id":"pattern-matching-chatbot","implicit":true,"key":"bV5qMkNQ0y"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"You can build a simple chatbot by storing a series of potential questions and answers. That is, “if the user says X, then answer Y”. We are going to try that here. We will use spaCy’s ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eHaOx6Nz0h"},{"type":"link","url":"https://spacy.io/usage/rule-based-matching","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Matcher","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"LwP5UnyM3l"}],"urlSource":"https://spacy.io/usage/rule-based-matching","key":"GikrP3KG7G"},{"type":"text","value":" module to do that.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"T3ZAj117Ar"}],"key":"D3MbllQtAL"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"This particular implementation is based on ","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"f52RdmOh8m"},{"type":"link","url":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Ahilya’s","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"thfjLnaqXy"}],"urlSource":"https://heartbeat.comet.ml/chatbot-development-using-spacy-4f6515cb17b8","key":"DkgdDNL00G"},{"type":"text","value":". It produces an extremely simple dialogue; just a greeting and only in response to “hello”. You can extend it with other patterns.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jQDVbRkSoi"}],"key":"vNDL6h9fxe"}],"key":"ROhiLE8YOD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Import statements and load spaCy","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"qJqbSR0WDi"}],"identifier":"import-statements-and-load-spacy","label":"Import statements and load spaCy","html_id":"import-statements-and-load-spacy","implicit":true,"key":"NI29QydhZd"}],"key":"SGtKbM1HZW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import spacy\nfrom spacy.matcher import Matcher\n\nnlp = spacy.load(\"en_core_web_sm\")","key":"N1FGb0NpV1"},{"type":"outputs","id":"z1V4jjvC3yR_c7uyknrde","children":[],"key":"hk2mKlZv5n"}],"key":"eCPIHESXgl"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Create the chatbot matching","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"oZB8ya72tP"}],"identifier":"create-the-chatbot-matching","label":"Create the chatbot matching","html_id":"create-the-chatbot-matching","implicit":true,"key":"gdhsWObQGy"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"The code has 2 parts:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"eKSDfxo8ZO"}],"key":"bfz7cZ0931"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Create a few patterns, such as “Greeting” = “hello”","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"eyx0fHF4PM"}],"key":"rRhtpgffw2"}],"key":"K4SPJXuQiZ"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Do a loop to get the input (parsing it with spaCy) and produce output","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"kQGrVoM2uP"}],"key":"VxnG2ygpoz"}],"key":"GRKxny4LqC"}],"key":"BxJpfOe72e"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"At any point, when you are done, type ‘quit’ to leave the dialogue.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"gTlRKCMjVS"}],"key":"TEWs1gDuQE"}],"key":"Ni3A8PPS5V"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# set up the matcher to recognize specific patterns\nmatcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}]])\n\n# define the chatbot's interaction loop\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": # type 'quit' to exit the prompt below\n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            print(\"Bot: Hello there!\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"yFT8Ykfnn5"},{"type":"outputs","id":"0vn4sdkC-p6B7O6aTGxgm","children":[],"key":"JdxsDvGBUq"}],"key":"OplCCp6Oq1"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Add more rules","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eDQg7BfR7W"}],"identifier":"add-more-rules","label":"Add more rules","html_id":"add-more-rules","implicit":true,"key":"ikiYxfnkI5"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We are adding also “hi” to the list of Greetings, and giving a slightly different answer if “hi” is said, instead of “hello”. Then we add a new type of interaction, “Help_request”, where the system catches any instance of the word “help” in the prompt and answers. Finally, we add a default answer, where the bot doesn’t match anything, so that the user rephrases.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"nxnXi5clA4"}],"key":"WChIADbFKN"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Play around with this and add as many types of rules and as many matches as you want.","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"cHpAHjMPYA"}],"key":"wo7GRDkcwq"}],"key":"V2Akpg8em3"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"matcher = Matcher(nlp.vocab)\nmatcher.add(\"Greeting\", [[{\"LOWER\": \"hello\"}], [{\"LOWER\": \"hi\"}], [{\"LOWER\": \"morning\"}]])\nmatcher.add(\"Help_request\", [[{\"LOWER\": \"help\"}]]) \n\nwhile True:\n    message = input(\"You: \")\n    if message.lower() == \"quit\": \n        break\n    else:\n        matches = matcher(nlp(message))\n        if matches:\n            if \"hello\" in message.lower():\n                print(\"Bot: Hello there!\")\n            elif \"hi\" in message.lower():\n                print(\"Bot: Hey! How's it going?\")\n            elif \"morning\" in message.lower():\n                print(\"Bot: Good morning!\")\n            elif \"help\" in message.lower():\n                print(\"Bot: What can I help you with?\")\n        else:\n            print(\"Bot: I'm sorry, can you please rephrase?\")","key":"CS67vZNBxg"},{"type":"outputs","id":"aiMRx3kE6LO6X92irgjMu","children":[],"key":"b6nYKGsCGF"}],"key":"PibJkMqhSR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zSPpLtdsEl"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"by6QenURi6"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We have learned about simple chatbots and started a pattern-matching chatbot. Check the Canvas page for more links to other types of chatbots.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Fn5CVKKgTd"}],"key":"sO44ypgnUY"}],"key":"DzO4WMoX2Z"}],"key":"kliC47FydG"},"references":{"cite":{"order":["Weizenbaum_1966"],"data":{"Weizenbaum_1966":{"label":"Weizenbaum_1966","enumerator":"1","doi":"10.1145/365153.365168","html":"Weizenbaum, J. (1966). ELIZA—a computer program for the study of natural language communication between man and machine. <i>Communications of the ACM</i>, <i>9</i>(1), 36–45. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1145/365153.365168\">10.1145/365153.365168</a>","url":"https://doi.org/10.1145/365153.365168"}}}}}