:1},"end":{"line":6,"column":1}},"key":"JUzX5LE91k"}],"key":"Qc9zvwXCRV"},{"type":"heading","depth":4,"position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Lemmatization","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"XIzYotahUY"}],"identifier":"lemmatization","label":"Lemmatization","html_id":"lemmatization","implicit":true,"key":"vg0AsNX8UI"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"Lemmatizers are a bit smarter about inflection and are able to identify roots, even when no suffixes are involved (gave -> give; feet -> foot). We’ll use the ","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"l7aKtZgNDC"},{"type":"link","url":"https://www.nltk.org/api/nltk.stem.WordNetLemmatizer.html?highlight=wordnet","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"text","value":"WordNet lemmatizer","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"p7sAEN4cj9"}],"urlSource":"https://www.nltk.org/api/nltk.stem.WordNetLemmatizer.html?highlight=wordnet","key":"rm71A29rcW"},{"type":"text","value":" in NLTK.","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Pj8SxO8JNF"}],"key":"tvHZ1fkEip"}],"key":"OEpgiRAWnT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# assign the stemmer to a variable, 'stemmer'\nstemmer = PorterStemmer()\n\n# go through the list of tokens (tokens1)\n# lower the tokens in that list\n# use list comprehension (with the square brackets)\n # so that the stemmer can iterate over the list\ntokens1_st = [stemmer.stem(token.lower()) for token in tokens1]\ntokens2_st = [stemmer.stem(token.lower()) for token in tokens2]","key":"R9RdkVB8cN"},{"type":"outputs","id":"MqfcE3EJQd8ZmTsKV4oDl","children":[],"key":"UNjrjZhVYX"}]