-remove-non-ascii-characters-remove-html-tags","label":"Other options: remove non-ASCII characters, remove HTML tags","html_id":"other-options-remove-non-ascii-characters-remove-html-tags","implicit":true,"key":"uNSIrqNfhI"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"There are additional things you may want to do to clean and normalize text, including converting everything to ASCII (wéïrdest -> weirdest) and removing HTML tags (‘","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AOXg5qqRqu"},{"type":"inlineCode","value":"<br>","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"wSnCqsozXC"},{"type":"text","value":"’, -> ‘’ ). You’ll probably want to do that before tokenization, so that the angle brackets in HTML don’t get tokenized as punctuation.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"jvPThpxiei"}],"key":"cSCzKEFa3z"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"The ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ggLKaLbQ0Q"},{"type":"link","url":"https://pypi.org/project/emoji/","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"emoji","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"P1xd5x1OnN"}],"urlSource":"https://pypi.org/project/emoji/","key":"JJsF9Snruh"},{"type":"text","value":" library can also convert UTF emoji into descriptions (🤗 -> ‘hugging face’)","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"HILoXNGOHQ"}],"key":"Z8y1BNllVX"}],"key":"ZSBZgyF3m9"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Normalizing text with spaCy","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"NWCF6p7899"}],"identifier":"normalizing-text-with-spacy","label":"Normalizing text with spaCy","html_id":"normalizing-text-with-spacy","implicit":true,"key":"eMRNEAUATp"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Now that you have seen how to do this with NLTK, the good news is that spaCy will do pretty much everything you need to do to clean and normalize text. It will also give you morphological and syntactic information about it. Go to the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"xcdzVnCoOq"},{"type":"inlineCode","value":"spacy_install.ipynb","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"G65n8VUuSL"},{"type":"text","value":" notebook for more information on how spaCy works.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"q1DPc1y7O8"}],"key":"qeqr6GWcdd"},{"type":"paragraph","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"We call spaCy by using the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Hwr7eRdtEE"},{"type":"inlineCode","value":"nlp","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"LXX6hQ35BB"},{"type":"text","value":" object and passing it the text that we want to process. Then we can query and print the information contained in the ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"ELDXvlEkUl"},{"type":"inlineCode","value":"doc","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"HrODhYIlOE"},{"type":"text","value":" object that spaCy creates.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"BSUuz4CjYy"}],"key":"ChGcnwtPED"}],"key":"yHBVF2ibcu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# process the text with spaCy\ndoc1 = nlp(text1)\ndoc2 = nlp(text2)","key":"iB45lKc7Mn"},{"type":"outputs","id":"G5eZztQB61Da8bELz388l","children":[],"key":"b55FA5FdI1"}],"key":"nBr0tfB986"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# print the 'text' attribute of each of the tokens\nfor token in doc1:\n    print(token.text)","key":"v9Wa3DVRcY"},{"type":"outputs","id":"YhPYix0JufFFpn58Z7-To","children":[],"key":"jsHNXfloki"}],"key":"JVKX3Wi141"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# if you want to see this in a single line, you can join the strings in the list, with a space between each\nprint(\" \".join([token.text for token in doc1]))\nprint(\"\\r\") # this is just so that the two texts are separated on the screen by an empty line\nprint(\" \".join([token.text for token in doc2]))","key":"FrBM2VXF2Z"},{"type":"outputs","id":"tQleQ4DggA73OtU9m510b","children":[],"key":"k8EI114zwZ"}],"key":"bB3mPsBJRi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# print the lemmas\nprint(\" \".join([token.lemma_ for token in doc1]))\nprint(\"\\r\")\nprint(\" \".join([token.lemma_ for token in doc2]))","key":"lNYzo4t4W0"},{"type":"outputs","id":"ND7yRSkODc4j-QoQOoxcp","children":[],"key":"Z8a96hDJel"}],"key":"WMPhI0xjrJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# print the part of speech of each word after the word\nprint(\" \".join([f\"{token.text}/{token.pos_}\" for token in doc1]))\nprint(\"\\r\")\nprint(\" \".join([f\"{token.text}/{token.pos_}\" for token in doc2]))","key":"ChtAEBMDn7"},{"type":"outputs","id":"cosJ_Bz0OCGYinKJZ4p_u","children":[],"key":"niPpxM7UU0"}],"key":"pJZV3eTlz5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# the doc object in spaCy contains all kinds of information\n# including rich morphology for each word\nfor token in doc1:\n    print(token.text, \"\\t\\t\", token.lemma_, \"\\t\\t\", token.pos_, \"\\t\\t\", token.morph) # the \\t helps show sort of columns","key":"qjUjcSuyGX"},{"type":"outputs","id":"UmuhkUvuHsz2sv0J5YmAo","children":[],"key":"n5mDDZtrfe"}],"key":"HeIAgM2A9o"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# if you don't know what the abbreviations mean, \n# you can ask for an explanation\nspacy.explain(\"ADP\")","key":"x6D4Vf7bCE"},{"type":"outputs","id":"rutXsSQ2WQpYf5gS_uejp","children":[],"key":"E29UdmHIO6"}],"key":"yUQjvqyolv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# doc also includes syntactic information about heads and dependents\n# including rich morphology for each word\nfor token in doc1:\n    print(token.text, \"\\t\\t\", token.pos_, \"\\t\\t\", token.dep_, \"\\t\\t\", token.head)","key":"yT37VhQSAC"},{"type":"outputs","id":"kgPPE25eYtXGaRwF1hS-B","children":[],"key":"s6wpZg3hoV"}],"key":"Au2JhcBaxE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# btw, you can still count tokens and types with spaCy\ntokens1 = [token.text for token in doc1]\ntypes1 = set(tokens1)\n\n# you can see those lists\nprint(\"tokens: \", tokens1)\nprint(\"\\r\")\nprint(\"types: \", types1)\n\n# and you can print their length\nprint(\"\\r\")\nprint(\"number of tokens: \", len(tokens1))\nprint(\"number of types: \", len(types1))","key":"gnSwuDtBLX"},{"type":"outputs","id":"Os5QG1cU-A2zFFwppoYQY","children":[],"key":"CK5Av8gTx9"}],"key":"SI6VmTcO6b"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":4,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Using pandas to show the output","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dkYL5V64c5"}],"identifier":"using-pandas-to-show-the-output","label":"Using pandas to show the output","html_id":"using-pandas-to-show-the-output","implicit":true,"key":"zWmKFsLbOU"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"You can also store the information into a pandas dataframe, which makes it much more readable and easy to save.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aSJ90TFsLM"}],"key":"A1tlkfDOuR"}],"key":"rwsrDN3nWu"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"data1 = []\n\nfor token in doc1:\n    data1.append([token.text, token.pos_, token.dep_, token.head])\n    \ndf = pd.DataFrame(data1)\ndf.columns = ['Text', 'Tag', 'Dependency', 'Head']\n\ndf","key":"gVClLkgLac"},{"type":"outputs","id":"Psf4TxPe58wdQ3t51ibRR","children":[],"key":"pamLOYDWaW"}],"key":"d2dNTEnVGR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Named Entity Recognition","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kuyowLctfx"}],"identifier":"named-entity-recognition","label":"Named Entity Recognition","html_id":"named-entity-recognition","implicit":true,"key":"UL9AgcfImM"},{"type":"paragraph","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Named Entity Recognition (NER) is the process of identifying and labelling ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"KneUFQTSs4"},{"type":"emphasis","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"named entities","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"ByQ9ofsZEl"}],"key":"Hc33MY06IM"},{"type":"text","value":", that is, real world objects, locations, and identifiers such as dates, currency, or quantities. It is very useful if you want to know, for instance, who is mentioned in a text, which countries are involved, or which dates. It is what allows your email or messaging application to identify dates and suggest a calendar entry, as in the image below, from the iPhone Notes app.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"YKM5k7UjU0"}],"key":"yVwIZzOl3S"},{"type":"link","url":"/ner_date-fc91624d1a29b51f7662a1694b789a2a.jpeg","children":[{"type":"image","style":{"border":"1px solid gray","padding":"5px"},"url":"/ner_date-fc91624d1a29b51f7662a1694b789a2a.jpeg","width":100,"height":200,"key":"aQFfwJcuMl","urlSource":"./img/ner_date.jpeg"}],"urlSource":"./img/ner_date.jpeg","static":true,"protocol":"file","key":"vEg2g8Fw5a"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"spaCy has a pretty powerful NER module. It can give you the named entities in a text, with the label for each word that is part of the entity. It also knows the boundaries of the entire entity. So it knows that “Clean”, “Energy”, “Research”, and “Group” all have the ORG (for organization) label, but it also knows that the full entity is “Clean Energy Research Group”.","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"pBdkPdqEEq"}],"key":"L2YJrwowKn"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"You can list all the entities in a text with the usual for loop. Using the ","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"MXiMyIjm2V"},{"type":"link","url":"https://spacy.io/usage/visualizers","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"displacy module","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"l4s6pijmZt"}],"urlSource":"https://spacy.io/usage/visualizers","key":"zWeIoShxUc"},{"type":"text","value":", you can also visualize the boundaries and the types in different colours.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"GxTo9o9EJ7"}],"key":"tT8AtLVmJI"}],"key":"o6PPxkOcNf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# print each token and its entity label, if it has one\nfor ent in doc1.ents:\n    print(ent.text, ent.label_)","key":"huHZ1jFgXB"},{"type":"outputs","id":"72t2CAEvYVH7dtzl5Ig0U","children":[],"key":"PFmGqIIkfy"}],"key":"LX9cGL6ZMF"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# same for doc2, but it doesn't contain entities\nfor ent in doc2.ents:\n    print(ent.text, ent.label_)","key":"GPD6qcGQe2"},{"type":"outputs","id":"zBEUnqUL8lgZgxA0xroCa","children":[],"key":"lmf0BCoSH8"}],"key":"HxODwN8K4a"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# it's useful to count and store the named entities in a text\n\n# create an empty list\nnamed_ents1 = []\n\n# go through the entities and append each to the list\nfor ent in doc1.ents:\n    named_ents1.append((ent.text, ent.label_))\n    \nprint(named_ents1)","key":"zfcFYtBGYq"},{"type":"outputs","id":"karCSG6hPn3olO3rR3lZb","children":[],"key":"kRgeMZT7TK"}],"key":"XjzSB7bVYp"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# create a df for the entities, from the list above \ndf_ents1 = pd.DataFrame(named_ents1)\n# name the columns\ndf_ents1.columns = ['Entity', 'Label']\n# print\ndf_ents1","key":"YkcFYLzT4M"},{"type":"outputs","id":"I8f7acBw0UBI0kanAdmfv","children":[],"key":"bMJAL9AlOe"}],"key":"vOCfrCwQQK"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# visualize the entities\ndisplacy.render(doc1, style=\"ent\", jupyter=True)","key":"kQkP0VaS5j"},{"type":"outputs","id":"k02COl6UK_Jfr1nDxxPgq","children":[],"key":"OQ2nqJfwMW"}],"key":"VMKpiQaeEp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Summary","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QQ5Vy4Gj7Z"}],"identifier":"summary","label":"Summary","html_id":"summary","implicit":true,"key":"XQvEWZW7XV"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"We have learned quite a bit! Text normalization includes:","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"A7Vm668x7K"}],"key":"AcNmrF8XeO"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Lowercasing the words","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"e1InjRnNEk"}],"key":"mdV2PxHEdE"}],"key":"SFtdLyRpef"},{"type":"listItem","spread":true,"position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Tokenizing (identifying words, punctuation, anything else)","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"lOfNAJG4WY"}],"key":"eAjk5hSA6V"}],"key":"LyMpoxKqB6"},{"type":"listItem","spread":true,"position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Stemming","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"JZVuM1yHhk"}],"key":"b1QJC0Kop9"}],"key":"ns5LqiYJK6"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Lemmatizing","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"YjC5ScY9xS"}],"key":"LEAbk1Bnn4"}],"key":"GBBJg1MIUG"}],"key":"sIOAcvi2FW"},{"type":"paragraph","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"And we have learned to do this with both NLTK and spaCy.","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"kYNcoIOxF1"}],"key":"aXwrFgwfep"},{"type":"paragraph","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"We have also learned about ","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"dzvMVt6JLV"},{"type":"strong","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"Named Entity Recognition","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"VoPaLoktm8"}],"key":"b1h3GdMWDy"},{"type":"text","value":" and how to extract entities with spaCy.","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"GDyCwcTLIS"}],"key":"o6pGa6Qu79"}],"key":"KRtuAowXWA"}],"key":"ya8JHbYHUN"},"references":{"cite":{"order":[],"data":{}}}}